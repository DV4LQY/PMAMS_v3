APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pms_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Layered login protection (Google reCAPTCHA v3). Keep disabled for local/IP deployments
# unless the site key is registered for that hostname.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_HOSTNAME=pmams.catsu.edu.ph

# Optional offline maintenance-attention model. Leave enabled; without a
# trained model the page safely uses deterministic Laravel rules only.
MAINTENANCE_AI_ENABLED=true
MAINTENANCE_AI_AUTO_TRAIN=true
MAINTENANCE_AI_TRAIN_DAY=1
MAINTENANCE_AI_TRAIN_TIME=03:30
MAINTENANCE_AI_MIN_SAMPLES=20
MAINTENANCE_AI_PYTHON=python
MAINTENANCE_AI_TIMEOUT=10
MAINTENANCE_AI_TRAINING_TIMEOUT=60
MAINTENANCE_AI_CACHE_MINUTES=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Optional second copy for scheduled backups. Use a UNC path on deployment
# when the PHP/Task Scheduler account cannot access mapped drive letters.
PMAMS_BACKUP_PATH="Z:\\PMAMS_Backup"
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
